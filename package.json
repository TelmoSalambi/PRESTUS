{
  "name": "prestus-monorepo",
  "version": "1.1.0",
  "private": true,
  "description": "PRESTUS — Website Institucional (React + Vite, 100% estático. Contacto exclusivo via WhatsApp)",
  "scripts": {
    "predev": "node scripts/free-ports.js",
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm --prefix platform/frontend run dev",
    "build": "npm run build:frontend",
    "build:frontend": "npm --prefix platform/frontend run build",
    "postinstall": "npm --prefix platform/frontend install",
    "lint": "npm --prefix platform/frontend run lint",
    "format": "npm --prefix platform/frontend run format",
    "format:check": "npm --prefix platform/frontend run format:check",
    "preview": "npm --prefix platform/frontend run preview",
    "deploy": "npx vercel --prod",
    "deploy:preview": "npx vercel"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
