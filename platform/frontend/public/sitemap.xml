<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">

  <!--
    PRESTUS — sitemap
    Single-URL app: PT é a versão padrão ("/"), EN é servida via "?lang=en".
    Quando o domínio definitivo estiver registado, substituir www.prestus.ao
    e, se for criada uma rota /en/, atualizar os hreflang em simultâneo
    (sitemap.xml, robots.txt e <head> do index.html).
  -->
  <url>
    <loc>https://www.prestus.ao/</loc>
    <lastmod>2026-09-28</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    <xhtml:link rel="alternate" hreflang="pt" href="https://www.prestus.ao/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://www.prestus.ao/?lang=en"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://www.prestus.ao/"/>
  </url>

</urlset>
