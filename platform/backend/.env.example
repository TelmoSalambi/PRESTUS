# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Number of proxy hops (or a proxy IP) between the app and the internet.
# Required in production so rate limiting sees the real client IP.
# TRUST_PROXY=1

# Firebase Firestore Configuration
# Option A: Service Account JSON file path
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Option B: Environment Variables from Firebase Console
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Use \n for newlines in private key
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Email Notifications (SMTP / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_app_password_here
NOTIFICATION_EMAIL=notifications@yourdomain.com